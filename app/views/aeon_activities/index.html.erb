<%= flash_column_classes 'col-lg-9' %>
<div class="row">
  <div class="col-lg-9">
    <div class="d-sm-flex mb-2">
    <h1 class="mt-2 me-3">Activities</h1>
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <button class="nav-link <%= 'active' unless params[:past] %> fs-5" data-bs-toggle="tab" data-bs-target="#active-tab">Current</button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= 'active' if params[:past] %> fs-5" data-bs-toggle="tab" data-bs-target="#past-tab">Past</button>
      </li>
    </ul>
    <div class="tab-underline-extend flex-grow-1 border-bottom d-none d-sm-block">
    </div>
  </div>

  <div class="tab-content">
    <div id="active-tab" class="tab-pane fade <%= 'show active' unless params[:past] %>">
      <% if @activities.present? %>
        <div class="d-flex flex-wrap justify-content-end gap-2 my-2">
          <%= render 'filters', activity_types: @activities.active.map(&:activity_type) %>
          <%= render 'sort' %>
        </div>

        <%= render Aeon::ActivityComponent.with_collection(@activities.active) %>
      <% else %>
        You have no activities
      <% end %>

      <%= turbo_frame_tag 'activity_requests', src: requests_aeon_activities_path(filter: params[:filter]) %>
    </div>

    <div id="past-tab" class="tab-pane fade <%= 'show active' if params[:past] %>">
      <% if @activities.present? %>
        <div class="d-flex flex-wrap justify-content-end gap-2 my-2">
          <%= render 'filters', activity_types: @activities.past.map(&:activity_type) %>
          <%= render 'sort' %>
        </div>

        <%= render Aeon::ActivityComponent.with_collection(@activities.past) %>
      <% else %>
        You have no past activities
      <% end %>
      <%= turbo_frame_tag 'past_activity_requests', src: requests_aeon_activities_path(filter: params[:filter], past: true), loading: :lazy %>
    </div>

  </div>
  </div>
</div>
