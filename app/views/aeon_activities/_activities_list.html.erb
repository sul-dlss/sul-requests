<div data-controller="sortable">
  <div class="d-flex flex-wrap justify-content-end gap-2 my-2">
    <%= render System::SortableFilterDropdownComponent.new(active_label: 'All', prepend_id: params[:past] ? 'past' : 'active') do |component| %>
      <% component.with_list_item(label: 'All', field: '') %>
      <% activities.map(&:activity_type)&.each do |activity_type| %>
        <% component.with_list_item(label: activity_type, field: activity_type) %>
      <% end %>
    <% end %>

    <%= render System::SortableDropdownComponent.new(active_label: 'date', prepend_id: params[:past] ? 'past' : 'active') do |component| %>
      <% component.with_list_item(label: 'date', field: 'date') %>
      <% component.with_list_item(label: 'activity name', field: 'name') %>
      <% component.with_list_item(label: 'activity type', field: 'activityType') %>
    <% end %>
  </div>

  <div data-sortable-target="list observe" aria-live="polite">
    <%= render Aeon::ActivityComponent.with_collection(activities) %>
  </div>
</div>
