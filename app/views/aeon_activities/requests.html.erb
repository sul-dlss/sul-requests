<turbo-frame id="<%= 'past_' if params[:past] %>activity_requests">
  <% @activities.each do |activity| %>
    <%= turbo_stream.replace dom_id(activity, :requests) do %>
      <div id="<%= dom_id(activity, :requests) %>">
        <%= render Aeon::ActivityRequestsComponent.new(activity: activity) %>
      </div>
    <% end %>
    <%= turbo_stream.replace dom_id(activity, :item_pill) do %>
      <%= render PillComponent.new(id: dom_id(activity, :item_pill), classes: %w[bg-stanford-20-black text-stanford-black px-2]).with_content(pluralize(activity.requests.length, 'item')) %>
    <% end %>
  <% end %>
</turbo-frame>
