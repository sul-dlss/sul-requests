<turbo-frame id="<%= 'past_' if params[:past] %>activity_requests">
  <% @activities.each do |activity| %>
    <%= turbo_stream.replace dom_id(activity, :requests) do %>
      <%= render Aeon::ActivityRequestsComponent.new(activity: activity) %>
    <% end %>
    <%= turbo_stream.replace dom_id(activity, :item_pill) do %>
      <%= render PillComponent.new(classes: %w[bg-stanford-20-black text-stanford-black px-2]).with_content(pluralize(activity.requests.length, 'item')) %>
    <% end %>
  <% end %>
</turbo-frame>
