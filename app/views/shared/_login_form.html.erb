<%# locals: (referrer: nil, name_email_access_allowed: true) %>
<div class="row flex-column flex-sm-row landing-page mb-3">
  <div class="col-sm-6">
    <div class="card">
      <h2 class="card-header bg-white">Stanford community</h2>
      <div class="card-body">
        <%= link_to 'Log in with SUNet ID', login_by_sunetid_url(referrer: referrer), data: { turbo: false }, class: 'btn btn-md btn-secondary btn-full mb-2' %>
        <p>For Stanford faculty, students, staff, postdocs, fellows, visiting scholars, and Graduate Medical Education (GME) staff and fellows with a SUNet ID. <span class="fw-semibold">By using your SUNet ID, you can access more library services, including requesting items from partner libraries or receiving digital scans via email.</span></p>
        <a href="https://library.stanford.edu/services/borrow-and-request" target="_blank" class="su-underline">
          Review borrow and request policies<i class="bi bi-arrow-up-right ms-1" aria-hidden></i>
        </a>
      </div>
    </div>
  </div>
  <div class="col-sm-6 mt-4 mt-sm-0">
    <div class="card border-0 mb-2">
      <div class="card-header bg-white border-0 d-flex align-items-center gap-3">
        <h2 class="mb-0">Library cardholder</h2>
        <a href="https://library.stanford.edu/about-stanford-libraries/visitor-access#how-to-request-a-library-card" target="_blank" class="small su-underline text-nowrap">Learn more<span class="visually-hidden"> about library cardholder access</span><i class="ms-1 bi bi-arrow-up-right" aria-hidden></i></a>
      </div>
      <div class="card-body pt-0">
        <p>For people with a purchased or courtesy library card.</p>
        <details data-action="analytics#send" data-analytics-action-param="Library ID" data-analytics-category-param="Login">
          <summary class="btn btn-link p-0 su-underline">Login with Library ID/PIN <i class="bi bi-chevron-right disclosure-icon"></i></summary>
          <%= form_tag login_by_university_id_url, method: 'POST', class: 'form p-3', data: { turbo: false } do %>
            <%= hidden_field_tag :referrer, referrer %>
            <div class="form-group mt-2">
              <label class="form-label required-label" for="university_id"><%= t('sessions.university_id.label') %></label>
              <input class="form-control" id="university_id" name="university_id" aria-describedby="university-id-help" required>
              <div class="form-text" id="university-id-help"><%= t('sessions.university_id.help_text') %></div>
            </div>
            <div class="form-group mt-2">
              <label class="form-label required-label" for="pin">PIN</label>
              <input class="form-control" type="password" id="pin" name="pin" required autocomplete="on">
              <div class="form-text">
                <%= link_to "Forgot your PIN? Don't have one yet?", reset_pin_url(referrer: request.original_url), class: 'su-underline' %>
              </div>
            </div>
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-outline-secondary">
                Login
              </button>
            </div>
          <% end %>
        </details>
      </div>
    </div>
    <div class="card border-0 mb-2">
      <div class="card-header bg-white border-0 d-flex align-items-center gap-3">
        <h2 class="mb-0">Stanford Medicine</h2>
        <a href="https://library.stanford.edu/about-stanford-libraries/visitor-access#how-to-request-a-library-card" target="_blank" class="small su-underline text-nowrap">Learn more<span class="visually-hidden"> about Stanford Medicine access</span><i class="ms-1 bi bi-arrow-up-right" aria-hidden></i></a>
      </div>

      <div class="card-body pt-0">
        <p>For Stanford Medicine Health Care and Stanford Medicine Children's Health staff.</p>
        <details data-action="analytics#send" data-analytics-action-param="Stanford Medicine" data-analytics-category-param="Login">
          <summary class="btn btn-link p-0 su-underline">Login with Enterprise ID/Library PIN <i class="bi bi-chevron-right disclosure-icon"></i></summary>
          <%= form_tag login_by_university_id_url, method: 'POST', class: 'form p-3', data: { turbo: false } do %>
            <%= hidden_field_tag :referrer, referrer %>
            <div class="form-group mt-2">
              <label class="form-label required-label" for="enterprise_id"><%= t('sessions.enterprise_id.label') %></label>
              <input class="form-control" id="enterprise_id" name="university_id" aria-describedby="enterprise-id-help" required>
              <div class="form-text" id="enterprise-id-help"><%= t('sessions.enterprise_id.help_text') %></div>
            </div>
            <div class="form-group mt-2 mb-4">
              <label class="form-label required-label" for="enterprise_pin">Library PIN</label>
              <input class="form-control" type="password" id="enterprise_pin" name="pin" required autocomplete="on">
            </div>
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-outline-secondary">
                Login
              </button>
            </div>
          <% end %>
        </details>
      </div>
    </div>
    <div class="card border-0 mt-3 mt-sm-0 mb-2">
      <div class="card-header bg-white border-0 d-flex align-items-center gap-3">
        <h2 class="mb-0">Visitor</h2>
        <a href="https://library.stanford.edu/visitor-access" target="_blank" class="small su-underline text-nowrap">Learn more<span class="visually-hidden"> about visitor access</span><i class="ms-1 bi bi-arrow-up-right" aria-hidden></i></a>
      </div>
      <div class="card-body pt-0">
        <% unless name_email_access_allowed %>
          <div class="alert alert-danger text-cardinal">
            This item is not available to request for visitors. If you have a SUNet ID or library card, please login using one of those methods.
          </div>
        <% end %>
        <p>If you don’t have a SUNet ID or a library card, you might still be eligible for visitor access.
          Please note that in order to use materials in the library, you must first register for
          visitor access at one of the following libraries: Green Library,
          Art and Architecture Library (Bowes), East Asia Library or Music Library.
        </p>
        <details data-action="analytics#send" data-analytics-action-param="Library ID" data-analytics-category-param="Login">

          <summary class="btn btn-link p-0<% unless name_email_access_allowed %> disabled<% else %> su-underline<% end %>">Proceed as visitor <i class="bi bi-chevron-right disclosure-icon"></i></summary>
          <% if name_email_access_allowed %>
            <%= form_tag register_visitor_url, method: 'POST', class: 'form p-3', data: { turbo: false } do %>
              <%= hidden_field_tag :referrer, referrer %>
              <div class="form-group mt-2">
                <label class="form-label required-label" for="name">Name</label>
                <input class="form-control" id="name" name="name" required>
              </div>
              <div class="form-group mt-2">
                <label class="form-label required-label" for="patron_email">Email</label>
                <input class="form-control" id="patron_email" name="patron_email" type="email" autocomplete="email" required>
              </div>
              <div class="form-group mt-2">
                <%= recaptcha_tags %>
              </div>
              <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-outline-secondary">
                  Continue
                </button>
              </div>
            <% end %>
          <% end %>
        </details>
      </div>
    </div>
  </div>
</div>
