<% flash_types = { success: :success, notice: :info, alert: :warning, error: :danger } %>
<% if flash_types.keys.any? { |type| flash[type].present? } %>
  <div class="flash_messages <%= local_assigns[:classes] ? local_assigns[:classes] : 'mt-5' %>">
    <% flash_types.each do |flash_type, alert_type| %>
      <% Array(flash[flash_type]).each do |message| %>
        <%= render(AlertComponent.new(type: alert_type, dismissable: true, classes: %w[alert-dismissible fade show])) do %>
          <%= message.html_safe %> <%# herb:disable erb-no-unsafe-raw %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
