<%= tag.div class: 'page-section col-12 col-md-9', data: { controller: 'sortable google-cover-image', 'sortable-sort-value': 'default', 'sortable-filter-value': params[:filter] } do %>
  <div class="d-flex flex-wrap gap-2 justify-content-between mb-4">
    <h1>Submitted requests</h1>

    <div class="d-flex gap-2">
      <%= render System::SortableDropdownComponent.new(button_label: 'request timing') do |component| %>
        <% component.with_list_item(label: 'default', field: 'request timing') %>
        <% component.with_list_item(label: 'date modified', field: 'date') %>
        <% component.with_list_item(label: 'title', field: 'title') %>
      <% end %>

      <%= render System::SortableFilterDropdownComponent.new do |component| %>
        <% component.with_list_item(label: 'all requests', field: '') %>
        <% component.with_list_item(label: 'Digitization', field: 'digitization') %>
        <% component.with_list_item(label: 'Pickup', field: 'pickup') %>
         <% component.with_list_item(label: 'Reading room use', field: 'reading room') %>
      <% end %>
    </div>
  </div>

  <ul id="requests" class="requests p-0" data-sortable-target="list observe" aria-live="polite">
  </ul>

  <%= turbo_frame_tag :folio_requests, src: folio_requests_path(async: true) do %>
    <%= render CardComponent.new(element: 'div', classes: 'request placeholder-glow', aria: { hidden: true }) do |c| %>
      <% c.with_title do %>
        <div class="col-6">
          <div class="d-flex flex-wrap gap-1 justify-content-between align-items-center mt-2 mb-3">
            <%= render PillComponent.new(classes: %w[bg-lagunita-dark text-white placeholder]).with_content('Pickup') %>
          </div>

          <div class="placeholder w-100 h2"></div>
          <div class="placeholder w-100"></div>
        </div>
      <% end %>

      <% c.with_body do %>
        <div class="bg-white px-3 py-2 d-flex column-gap-4 row-gap-2 justify-content-between align-items-start flex-wrap flex-md-nowrap">
          <div class="placeholder col-4"></div>
          <div class="col-5"></div>
          <div class="placeholder col-1"></div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag :aeon_requests, src: aeon_requests_path(async: true, kind: 'submitted') do %>
    <%= render CardComponent.new(element: 'div', classes: 'request placeholder-glow', aria: { hidden: true }) do |c| %>
      <% c.with_title do %>
        <div class="col-6">
          <div class="d-flex flex-wrap gap-1 justify-content-between align-items-center mt-2 mb-3">
            <%= render PillComponent.new(classes: %w[bg-lagunita-dark text-white placeholder]).with_content('Reading room use') %>
          </div>

          <div class="placeholder w-100 h2"></div>
          <div class="placeholder w-100"></div>
        </div>
      <% end %>

      <% c.with_body do %>
        <div class="bg-white px-3 py-2 d-flex column-gap-4 row-gap-2 justify-content-between align-items-start flex-wrap flex-md-nowrap">
          <div class="placeholder col-4"></div>
          <div class="col-5"></div>
          <div class="placeholder col-1"></div>
        </div>
      <% end %>
    <% end %>
  <% end unless acting_as_proxy? %>

  <%= turbo_frame_tag :ill_requests, src: ill_requests_path(async: true) unless acting_as_proxy? %>
  <%= turbo_frame_tag :mediated_requests, src: mediated_requests_path(async: true) unless acting_as_proxy? %>

  <div class="no-requests">
    <h2>No submitted requests yet.</h2>
    <p>You can request library materials for pickup, ask to have an article or part of a book scanned and emailed to you, or request rare and distinctive materials for use in a reading room.
    Search for materials in <%= link_to 'SearchWorks', 'https://searchworks.stanford.edu/' %> or <%= link_to 'Archival Collections at Stanford', 'https://archives.stanford.edu/' %> to see the request options available.
    </p>
  </div>
<% end %>
