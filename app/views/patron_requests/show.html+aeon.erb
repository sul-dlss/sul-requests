<div class="row">
  <div class="confirmation col-12 col-lg-8">
    <% if @patron_request.request_type == 'scan' %>
      <h1>We received your digitization request!</h1>
    <% elsif @patron_request.request_type == 'activity' %>
      <h1>We received your activities request!</h1>
    <% else %>
      <h1>We received your reading room access request!</h1>
    <% end %>
    <%= render RecordHeaderComponent.for(@patron_request.bib_record, classes: 'bg-light mt-4 mb-4 p-4 rounded-0', title_classes: ['h3']) %>
    <div data-controller="aeon-confirmation-poll" data-aeon-confirmation-poll-attempts-value="0">
      <turbo-frame id="aeon-confirmation" data-aeon-confirmation-poll-target="frame">
        <% if @patron_request.submitted_to_aeon_at.nil? && !params[:stop_polling] %>
          <div class="d-flex align-items-center my-3" data-aeon-confirmation-poll-target="loading">
            <div class="spinner-border spinner-border-sm me-2" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <span>Confirming your requests. You can navigate away from this page.</span>
          </div>
        <% else %>
          <div class="confirmation">
            <% if @aeon_requests.any? %>
              <% if @aeon_requests.appointment_reading_room.present? %>
                <div class="mb-4">
                  <h2 class="h3"><%= @aeon_requests.appointment_reading_room.name %></h2>
                  <div class="mb-1"><i class="bi bi-geo-alt-fill me-1"></i><span><%= @aeon_requests.appointment_reading_room.directions %></span></div>
                  <% if @aeon_requests.appointment_reading_room.day_only_appointments? %>
                    <div><i class="bi bi-clock me-1"></i>Open hours: <span><%= @aeon_requests.appointment_reading_room.human_readable_hours %></span></div>
                  <% end %>
                </div>
              <% end %>
              <% @aeon_requests.requests.submitted.group_by(&:activity_id).each do |id, requests| %>
                <%= render Aeon::ConfirmationRequestListComponent.new(requests:, digitization: @aeon_requests.digital?, activity_id: id ) %>
              <% end %>
              <%= render Aeon::ConfirmationSavedForLaterComponent.new(request_group: @aeon_requests) %>
            <% end %>
          </div>
        <% end %>
      </turbo-frame>
    </div>
    <% if can? :debug, @patron_request %>
      <hr>
      <h2>Aeon Response</h2>
      <%= render ItemDebugStatusComponent.with_collection(@patron_request.patron_request_items) %>
    <% end %>
  </div>
  <%= render 'contact_aside' %>
</div>
