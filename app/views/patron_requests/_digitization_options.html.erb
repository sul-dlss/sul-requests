<fieldset class="row p-3 pt-0 gap-3 flex-column flex-md-row selected-items-container" data-patron-request-target="typePanel" data-request-type="scan" disabled>
  <legend class="visually-hidden">Digitization request details</legend>
  <%= render 'digitization_notice' %>

  <%= render 'save_for_later' %>
  <div class="accordion digitization-accordion px-0" data-patron-request-target="digitizationItems" data-item-selector-target="selectedItems" data-template="#digitizationTemplate">
    <% if f.object.selectable_items.one? %>
      <%= render Aeon::DigitizationFormItemComponent.for_selectable_item(item: f.object.selectable_items.first, base_name: "patron_request[aeon_item][#{f.object.selectable_items.first.id}]", accordion: false) %>
    <% end %>
  </div>

  <template id="digitizationTemplate">
    <%= render Aeon::DigitizationFormItemComponent.template %>
  </template>
</fieldset>
