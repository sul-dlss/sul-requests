<div class="row justify-content-center">
  <div class="col-lg-8">
    <%= render 'aeon_users/terms_text' %>

    <%= form_with url: accept_terms_aeon_user_path(referer: request.url), method: :post,
                  data: { controller: 'submit-gate', action: 'input->submit-gate#toggle' } do |f| %>

      <div class="my-3 px-3 py-2 bg-danger-subtle rounded-bottom d-flex flex-row justify-content-start align-items-baseline gap-2">
        <%= f.check_box :aeon_terms, { required: true }, 1, nil %>
        <div>
          <%= f.label "aeon_terms", 'I agree to these terms', class:'fw-bold redesign-required-label d-block' %>
          By checking this box, you acknowledge that you have read and agree to these Terms of use and to the policies applicable to the Stanford University Libraries reading rooms and services you use.
        </div>
      </div>

      <div class="d-flex justify-content-end">
        <%= f.submit 'Continue', class: 'btn btn-primary', data: { submit_gate_target: 'submit' } %>
      </div>
    <% end %>
  </div>
</div>
