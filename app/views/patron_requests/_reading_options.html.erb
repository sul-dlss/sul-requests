<fieldset class="row p-3 pt-0 gap-4 flex-column flex-md-row selected-items-container" data-patron-request-target="typePanel" data-request-type="pickup" disabled>
  <legend class="visually-hidden">Reading room appointment details</legend>
  <% appointments = current_user.aeon.appointments.for_site(f.object.aeon_site).select(&:editable?) %>
  <div id="new-appt-alert">
    <%= render AlertComponent.new(type: :info, classes: ['border-0', 'shadow-none'], dismissable: true) do %>
      <ul class="mb-0">
        <% if appointments.blank? %>
          <li>You don’t have any appointments yet. Create one to continue.</li>
        <% else %>
          <li>Select an eligible appointment - or - create a new one.</li>
        <% end %>

        <% if (f.object.aeon_reading_room.appointment_min_lead_days || 0) > 0 %>
        <li>Schedule an appointment at least <%= f.object.aeon_reading_room.appointment_min_lead_days %> business days in advance to use or view requested items.</li>
        <% end %>

        <% if f.object.aeon_reading_room.appointment_item_limit %>
          <li>Up to <%= f.object.aeon_reading_room.appointment_item_limit %> items are allowed per appointment.</li>
        <% end %>

        <% if f.object.aeon_site == 'ARS' %>
          <li>Depending on the format, recorded sound materials may need to be digitized by staff before they can be used in the reading room. <span class="fw-semibold">Scheduling an appointment does not provide faster access to these materials.</span></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%= render Aeon::ReadingRoomBriefComponent.new(reading_room: f.object.aeon_reading_room, create_appointment: true) %>

  <div>
    <%= render 'save_for_later' %>
    <ul class="appointments-container list-unstyled mb-0" data-item-selector-target="selectedItems" data-template="#appointmentTemplate">
      <% if f.object.selectable_items.one? %>
        <%= render Aeon::AppointmentFormItemComponent.for_selectable_item(item: f.object.selectable_items.first, base_name: "patron_request[aeon_item][#{f.object.selectable_items.first.id}]", reading_room_id: f.object.aeon_reading_room.id, appointments: appointments) %>
      <% end %>
    </ul>

    <template id="appointmentTemplate">
      <%= render Aeon::AppointmentFormItemComponent.template(reading_room_id: f.object.aeon_reading_room.id, appointments: appointments) %>
    </template>
  </div>

  <div id="additional-information" class="mb-2" data-controller="char-counter" data-char-counter-default-class="text-body-tertiary" data-char-counter-warning-class="text-cardinal">
    <%= f.label :aeon_reading_special, 'Additional information', :class => 'fw-bold py-2' %>
    <%= f.text_area :aeon_reading_special, :class => 'form-control', rows: 3, maxlength: 255, data: { action: "input->char-counter#updateCharCounter"} %>
    <p class="form-text text-secondary d-flex justify-content-between">
      <span>Limit 255 characters.</span>
      <span class="fs-14" data-char-counter-target="counter"></span>
    </p>
  </div>
</fieldset>
