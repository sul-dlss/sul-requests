<div data-controller="google-cover-image">
  <%= render RecordHeaderComponent.new(record: @request) do |c| %>
    <% c.with_cover_image do %>
      <%= render System::GoogleCoverImageComponent.new(identifiers: @request.identifiers) %>
    <% end %>
  <% end %>
</div>
<%= form_tag folio_request_path(@request.key), method: :patch do %>
  <%= hidden_field_tag :modal, params[:modal] if params[:modal] %>
  <div class="modal-body request-edit pt-0">
    <% if @request.vol_enum_chron.present? %>
      <div class="mb-3">
        <span class="text-black fw-semibold selected-item-title">
          <%= @request.vol_enum_chron %>
        </span>
      </div>
    <% end %>
    <%= hidden_field_tag :id, @request.key %>
    <%= hidden_field_tag :title, @request.title %>
    <%= hidden_field_tag :current_fill_by_date, @request&.fill_by_date&.strftime('%Y-%m-%d') %>
    <div class="form-group mb-3">
      <%= label_tag :service_point, 'Pickup point', class: 'form-label fw-semibold' %>
      <%= select_tag :service_point, request_location_options(@request, patron_or_group), class: 'form-control' %>
    </div>
    <% if @request.fill_by_date %>
      <div class="form-group mb-3">
        <%= label_tag :not_needed_after, 'Not needed after', class: 'form-label fw-semibold' %>
        <%= date_field_tag :not_needed_after, @request.fill_by_date.strftime('%Y-%m-%d'), class: 'form-control' %>
      </div>
    <% end %>
  </div>
  <div class="modal-footer">
    <%= link_to 'Cancel', :back, class: 'btn btn-outline-primary', data: { 'bs-dismiss': 'modal' } if request.variant.include?(:modal) %>
    <%= button_tag 'Submit request', class: 'btn btn-primary', type: 'submit' %>
  </div>
<% end %>
