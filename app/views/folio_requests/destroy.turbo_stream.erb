<%= turbo_stream.action('close', params[:modal]) if params[:modal] %>

<%= turbo_stream.remove(dom_id(@request)) %>

<% request_group = @grouped_requests.find { |group| group.catkey == @request.catkey } %>
<% remaining_requst_group_req = request_group.requests.reject { |req| req.id == @request.id } %>
<%= turbo_stream.remove(dom_id(request_group)) if remaining_requst_group_req.empty? %>
