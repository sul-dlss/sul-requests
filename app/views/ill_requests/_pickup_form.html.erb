<div class="mb-3">
  <%= f.label :item_info4, 'Preferred pickup location', class: 'form-label d-block fw-semibold redesign-required-label' %>
  <%= f.select(
  :item_info4, options_for_select(default_service_points(current_user.patron).map { |sp| [sp.name, sp.code] }), { include_blank: false, required: false },
  class: 'form-select'
  ) %>
</div>

<div class="text-cardinal mb-3 mt-1">
  Processing typically takes 7-10 business days.
</div>

<div class="mb-4">
  <%= f.label :not_wanted_after, 'Not needed after', class: 'form-label fw-semibold' %>
  <%= f.date_field :not_wanted_after, class: 'form-control', value: ((Date.today + 2.months).strftime("%Y-%m-%d") unless f.object.persisted?) %>
</div>
