<%= tag.public_send element, class: Array(classes) + ['request'], **attr do %>
    <div class="rgi-id d-flex align-items-center">
      <%= identifier %>
    </div>

    <% if detail? %>
      <div class="rgi-detail pb-1">
        <%= detail %>
      </div>
    <% end %>

    <% if fulfillment? %>
      <div class="request-fulfillment">
        <%= fulfillment %>
      </div>
    <% end %>

    <div class="rgi-actions">
      <turbo-frame>
        <div class="d-flex text-nowrap align-items-baseline align-self-start justify-content-xl-end">
          <%= actions %>
        </div>
      </turbo-frame>
    </div>

    <% if metadata? %>
      <div class="rgi-footer pt-2 fs-14 text-body-secondary d-flex gap-sm-3 flex-sm-row flex-column text-body-secondary small">
        <%= metadata %>
      </div>
    <% end %>

    <%= footer %>
<% end %>
