<%= tag.li id: dom_id(request, :appointment), class: classes + ['request px-2', request.status], data: request_sort_data do %>
    <div class="rgi-id d-flex align-items-center flex-row justify-content-between border-top">
      <%= render Aeon::RequestItemIdentifierComponent.new(request:) %>

      <turbo-frame>
        <% if request.activity? %>
          <div class="px-2 py-1">
            <%= render Aeon::RequestDeleteButtonComponent.new(request:) %>
          </div>
        <% else %>
          <%= render Aeon::SaveForLaterButtonComponent.new(request:) %>
        <% end %>
      </turbo-frame>
    </div>
<% end %>
