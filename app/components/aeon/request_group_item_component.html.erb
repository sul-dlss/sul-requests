<%= render System::GroupedRequestItemLayoutComponent.new(id: dom_id(request), request_id: transaction_number, date: transaction_date, classes: classes + [request.status], data: request_sort_data) do |c| %>
  <% c.with_identifier do %>
    <%= render Aeon::RequestItemIdentifierComponent.new(request:) %>
  <% end %>

  <% c.with_detail do %>
    <%= render Aeon::RequestItemDetailComponent.new(request:) %>
  <% end %>

  <% c.with_fulfillment do %>
    <%= render Aeon::RequestFulfillmentComponent.new(request:) %>
  <% end unless request.saved_for_later? %>

  <% c.with_actions do %>
    <%= render Aeon::RequestActionsComponent.new(request:) %>
  <% end %>
<% end %>
