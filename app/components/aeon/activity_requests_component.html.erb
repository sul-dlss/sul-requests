<% if activity.grouped_requests.any? %>
  <div class="d-flex justify-content-end mb-3">
    <%= link_to aeon_activity_path(activity.id, format: :csv), class: 'btn btn-outline-primary btn-sm' do %>
      <i class="bi bi-download me-1"></i>Download CSV
    <% end %>
  </div>
<% end %>

<%= render Aeon::AppointmentRequestGroupComponent.with_collection(activity.grouped_requests,
                                                                  classes: %w[activity-request-group card rounded-0 px-3 py-2 mb-2],
                                                                  show_item_link: true) %>

<% if activity.grouped_requests.none? %>
  <div role="alert" class="d-flex zero-items-alert align-items-center text-digital-red bg-body py-3 px-4">
    <div role="img" aria-label="Danger icon" class="bi bi-exclamation-triangle-fill fs-3 me-3 align-self-center d-flex justify-content-center ms-2"></div>
    <div class="me-2">
      No items have been requested for this activity.
    </div>
  </div>
<% end %>
