<% if include_bulk_actions? %>
  <span>
    <input type="checkbox" class="form-check-input" id="delete-bulk-<%= request.id %>"
      data-action="change->request-bulk-delete#updateDeleteButton request-bulk-delete#updateSelectAll"
      data-request-bulk-delete-target="select" data-id="<%= request.id %>">
    <%= label_tag "delete-bulk-#{request.id}", 'Select', class: 'ms-1 me-3 small form-check-label fw-normal' %>
  </span>
<% end %>

<% if helpers.can? :edit, request %>
  <%= link_to edit_aeon_request_path(request), class: 'btn btn-link btn-sm su-underline p-0 me-sm-2', data: { action: 'modal#open', modal_header: request.cancelled? ? 'Resubmit request' : 'Edit request' } do %>
    <% if request.saved_for_later? %>
      <% if request.digital? %>
        <i class="bi bi-file-earmark-plus me-1 align-middle"></i> Add instructions
      <% else %>
        <i class="bi bi-calendar-plus me-1 align-middle"></i> Add appointment
      <% end %>
    <% elsif request.cancelled? %>
      <i class="bi bi-arrow-repeat me-1 align-middle"></i> Resubmit
    <% else %>
      <i class="bi bi-pencil-fill me-1 align-middle" aria-hidden></i><span class="visually-hidden">Edit request</span>
    <% end %>
  <% end %>
<% end %>

<%= render Aeon::RequestDeleteButtonComponent.new(request: request) %>
