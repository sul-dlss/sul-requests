<%= render System::GroupedRequestsLayoutComponent.new(element: element, id: dom_id(request_group), classes: 'request-group', data: { 'filter-value': request_group.digital? ? 'digitization' : 'reading room',  'default-sort-value': request_group.sort_key(:default), 'title-sort-value': request_group.sort_key(:title), 'date-sort-value': request_group.sort_key(:date) }, show_more: show_more?, sortable: true) do |c| %>
  <% c.with_type_pill(content: status_text) %>

  <% c.with_details(appointment_reading_room.name) if appointment_reading_room.present? %>

  <% c.with_status_message do %>
    <span><i class="bi bi-exclamation-triangle-fill align-middle mx-2 text-digital-red"></i><span class="text-digital-red fw-normal"><%= digital? ? 'Pages/instructions not specified' : 'Not scheduled' %></span></span>
  <% end if saved_for_later? %>

  <% c.with_title(request_group.title) %>

  <% c.with_record_header do %>
    <div class="d-flex column-gap-md-3 flex-md-row flex-column flex-wrap">
      <span>
        <%= render FormatIndicatorComponent.new(record: request_group) %><% if request_group.date.present? %> (<%= request_group.date %>)<% end %>
      </span>
      <% if request_group.base_callnumber.present? && request_group.multi_item_selector? %>
        <span>Call number: <%= request_group.base_callnumber %></span>
      <% end %>
      <span>
        <%= render Aeon::RequestLinkComponent.new(url: request_group.item_url) %>
      </span>
    </div>
  <% end %>

  <% Aeon::RequestGroupItemComponent.with_collection(requests).each do |item| %>
    <% c.with_request do %>
      <%= render item %>
    <% end %>
  <% end %>
<% end %>
