<%= render System::GroupedRequestsLayoutComponent.new(element: element, id: request_group.dom_id, classes: 'request-group', data: { 'filter-value': request_group.digital? ? 'digitization' : 'reading room',  'default-sort-value': request_group.sort_key(:default), 'title-sort-value': request_group.sort_key(:title), 'date-sort-value': request_group.sort_key(:date) }, show_more: show_more?, sortable: true) do |c| %>
  <% c.with_type do %>
    <%= render Aeon::RequestStatusPillComponent.new(request: status_request) %>
  <% end %>

  <% c.with_details do %>
    <span class="appointment-details ms-1">
      <span class="ms-2 text-nowrap text-lagunita-dark"><%= appointment_reading_room.name %></span>
    </span>
  <% end if appointment_reading_room.present? %>

  <% c.with_status_message do %>
    <%= render Aeon::RequestStatusMessageComponent.new(request: status_request) %>
  <% end %>

  <% c.with_record_header do %>
    <%= render RecordHeaderComponent.new(record: requests.first, brief: true, display_callnumber: requests.first.multi_item_selector?) %>
  <% end %>

  <% Aeon::RequestGroupItemComponent.with_collection(requests).each do |item| %>
    <% c.with_request do %>
      <%= render item %>
    <% end %>
  <% end %>
<% end %>
