<% inner = capture do %>
  <span class="<%= classes.join(' ') %>">
    <% if call_number.present? || container.present? %>
      <% unless request.multi_item_selector? %>
        <span class="fw-normal">Call number: </span>
      <% end %>
      <%= call_number %>
      <% if separator? %><i class="bi bi-chevron-right"></i><% end %>
      <%= container %>
    <% else %>
      <span class="fw-normal fst-italic">(no call number)</span>
    <% end %>
  </span>
<% end %>
<% if wrapper_tag %>
  <%= tag.public_send(wrapper_tag, inner, class: wrapper_classes.join(' ')) %>
<% else %>
  <%= inner %>
<% end %>
