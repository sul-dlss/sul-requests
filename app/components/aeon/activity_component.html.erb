<%= render CardComponent.new(id: dom_id(activity)) do |c| %>
  <% c.with_title do %>
    <div class="d-flex flex-wrap gap-3 align-items-center">
      <%= render PillComponent.new(classes: %w[bg-bay-dark text-white]).with_content(activity.activity_type) %>
      <div class="d-flex flex-column">
        <h2 class="h4 text-bay-dark mb-0 card-title mb-0 h4 d-flex gap-3"><%= activity.name %></h2>
        <% if activity.start_time %>
          <div class="d-flex gap-3 mt-1">
            <%= render Aeon::AppointmentDateTimeComponent.new(appointment: activity, location: activity.location) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% c.with_body do %>
    <% if requests? %>
      <%= render Aeon::ActivityRequestsComponent.new(activity: activity) %>
    <% else %>
      <%= tag.div id: dom_id(activity, :requests), class: 'placeholder-glow' do %>
        <% rand(1..3).times do %>
          <div class="request-group request-group-per-appointment activity-request-group card rounded-0 px-3 py-2 mb-2">
            <div class="placeholder w-50"></div>
            <% rand(1..3).times do %>
              <div class="placeholder w-75 mt-3 ms-4"></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
