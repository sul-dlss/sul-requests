<%= render CardComponent.new(id: dom_id(activity), classes: 'accordion-item', header_attributes: {classes: %w[accordion-header p-0], id: dom_id(activity, :header)}) do |c| %>
  <% c.with_title do %>
    <button class="accordion-button d-flex justify-content-between px-3 py-2 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#<%= dom_id(activity, :accordion) %>" aria-expanded="false" aria-controls="<%= dom_id(activity, :accordion) %>">
      <div class="d-flex flex-wrap gap-3 align-items-center">
        <%= render PillComponent.new(classes: %w[bg-bay-dark text-white]).with_content(activity.activity_type) %>
        <div class="d-flex flex-column">
          <h2 class="h4 text-bay-dark mb-0 card-title mb-0 h4 d-flex gap-3"><%= activity.name %></h2>
          <% if activity.start_time %>
            <div class="d-flex gap-3 mt-1">
              <%= render Aeon::AppointmentDateTimeComponent.new(appointment: activity, location: activity.location) %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="d-flex">
        <% if requests? %>
          <%= render PillComponent.new(id: dom_id(activity, :item_pill), classes: %w[bg-stanford-20-black px-2 text-stanford-black]).with_content(pluralize(activity.requests.length, 'item')) %>
        <% else %>
          <span class="placeholder-glow" id="<%= dom_id(activity, :item_pill) %>">
            <%= render PillComponent.new(classes: %w[placeholder px-2]).with_content('Loading') %>
          </span>
        <% end %>
        <i class="ms-3 bi bi-chevron-down accordion-header-icon"></i>
      </div>
    </button>
  <% end %>

  <% c.with_body(classes: 'accordion-collapse collapse', data: { bs_parent: 'activity-accordions' }, id: dom_id(activity, :accordion), aria: {labelledby: dom_id(activity, :header) }) do %>
    <% if requests? %>
      <%= tag.div id: dom_id(activity, :requests) do %>
        <%= render Aeon::ActivityRequestsComponent.new(activity: activity) %>
      <% end %>
    <% else %>
      <%= tag.div id: dom_id(activity, :requests), class: 'placeholder-glow' do %>
        <% rand(1..3).times do %>
          <div class="request-group request-group-per-appointment activity-request-group card rounded-0 px-3 py-2 mb-2">
            <div class="placeholder w-50"></div>
            <% rand(1..3).times do %>
              <div class="placeholder w-75 mt-3 ms-4"></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
