<%= render System::GroupedRequestsLayoutComponent.new(id: dom_id(request), classes: 'request',  data: { 'filter-value': 'pickup', 'default-sort-value': request.sort_key(:default), 'title-sort-value': request.sort_key(:title), 'date-sort-value': request.sort_key(:date) }) do |c| %>
  <% c.with_type_pill(content: 'Pickup') %>

  <% c.with_details('Restricted to in-library use only') %>

  <% c.with_title(request.item_title) %>

  <% c.with_record_header do %>
    <div class="d-flex column-gap-md-3 flex-md-row flex-column flex-wrap">
      <%= render FormatIndicatorComponent.new(record: request) %>
      <% if request.patron_request_items.first&.item_callnumber.present? %>
        <span>Call number: <%= request.patron_request_items.first.item_callnumber %></span>
      <% end %>
      <span>
        <%= helpers.detail_link_to_searchworks(request.instance_hrid) %>
      </span>
    </div>
    <% if request.author %>
      <div class="mt-2">
        <%= request.author %>
      </div>
    <% end %>
  <% end %>

  <% c.with_body do %>
    <%= render System::GroupedRequestItemLayoutComponent.new(element: 'div', classes: %w[request-grid bg-white px-3 py-2]) do |c| %>
      <% c.with_identifier do %>
        <span class="fw-semibold me-1">Planned visit date:</span><%= l(request.needed_date, format: :short) %>
      <% end if request.needed_date.present? %>

      <% c.with_fulfillment_pending do %>
        <i class="bi bi-clock me-1" aria-hidden></i>Pending staff review/approval
      <% end %>

      <% c.with_actions do %>
        <%= render System::DeleteWithConfirmationComponent.new(id: dom_id(request, :delete), button_label: 'Cancel request', form_url: patron_request_path(request)) do |component| %>
          <% component.with_body do %>
            <div class="text-lagunita-dark">Pickup</div>

            <div class="d-flex flex-column gap-1">
              <div class="text-wrap fw-semibold"><%= request.item_title %></div>
            </div>
          <% end %>
        <% end if helpers.can?(:destroy, request) %>
      <% end %>


      <% c.with_metadata(date: request.updated_at, request_id: request.id) %>
    <% end %>
  <% end %>
<% end %>
