<div class="d-flex flex-row align-items-center gap-3 my-3">
  <span class="text-cardinal">Outstanding balance: <strong><%= number_to_currency(amount) %></strong></span>
  <div>
    <% if patron.can_pay_fines? %>
      <%= form_tag payments_path, data: { turbo: false }, method: :post do %>
        <%= hidden_field_tag :user_id, patron.key %>
        <%= hidden_field_tag :amount, format('%.2f', amount) %>
        <% fines.each do |fine| %>
          <%= hidden_field_tag 'fine_ids[]', fine.key %>
        <% end %>
        <%= button_tag class: 'btn btn-sm btn-secondary', type: 'submit', data: { 'pay-button' => true } do %>
          <span>Pay now</span>
        <% end %>
      <% end %>
    <% else %>
      <button class="btn btn-info" disabled><%= render Icons::PaymentComponent.new %> Payments blocked</button>
    <% end %>
  </div>
</div>
