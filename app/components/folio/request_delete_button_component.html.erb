<%= render System::DeleteWithConfirmationComponent.new(id: dom_id(request, :delete_modal), button_label: button_label, form_url: helpers.folio_request_path(request.key)) do |component| %>
  <% component.with_body do %>
    <div class="text-lagunita-dark"><%= request_type %></div>

    <div class="d-flex flex-column gap-1">
      <div class="text-wrap fw-semibold"><%= request.title %></div>
      <% if call_number.present? %>
        <div>Call number: <%= call_number %></div>
      <% end %>
    </div>
  <% end %>
<% end %>
