<%= render System::GroupedRequestsLayoutComponent.new(id: dom_id(request), classes: 'request', data: { 'filter-value': type_label.downcase, 'default-sort-value': request.sort_key(:default), 'title-sort-value': request.sort_key(:title), 'date-sort-value': request.sort_key(:date) }) do |c| %>
  <% c.with_type_pill(content: type_label) %>

  <% c.with_title(request.title) %>

  <% c.with_record_header do %>
    <div class="d-flex column-gap-md-3 flex-md-row flex-column flex-wrap">
      <% if request.call_number.present? %>
        <span>Call number: <%= request.call_number %></span>
      <% end %>
    </div>
    <% if request.author %>
      <div class="mt-2">
        <%= request.author %>
      </div>
    <% end %>
  <% end %>

  <% c.with_body do %>
    <%= render System::GroupedRequestItemLayoutComponent.new(element: 'div', request_id: request.id, date: request.placed_date, classes: %w[request-grid bg-white px-3 py-2]) do |item_component| %>
      <% item_component.with_identifier do %>
        <div class="request-item-identifier fw-semibold text-pretty rgi-id">
          <%= request.call_number.presence || request.photo_article_title.presence || 'Interlibrary Loan' %>
        </div>
      <% end %>

      <% if request.ready_for_pickup? %>
        <% item_component.with_fulfillment_ready do %>
            <i class="bi bi-bag me-1" aria-hidden></i>Awaiting pick up at <span class="fw-semibold"><%= request.service_point_name %></span>
              <% if request.expiration_date %>
                by <span class="fw-semibold"><%= l(request.expiration_date, format: :date_only) %></span>.
              <% end %>
        <% end %>
      <% else %>
        <% item_component.with_fulfillment_pending do %>
          <i class="bi bi-clock me-1" aria-hidden></i><span class="fw-semibold">Staff processing</span><% if request.service_point_name %> for pick up at <%= request.service_point_name %><% end %>
        <% end %>
      <% end %>

      <% item_component.with_actions do %>
        <% if helpers.can?(:edit, request) %>
          <%= link_to edit_ill_request_path(request.key), class: 'btn btn-link btn-sm su-underline p-0 me-sm-2', data: { action: 'modal#open', modal_header: 'Edit request' } do %>
            <i class="bi bi-pencil-fill me-1" aria-hidden></i><span class="visually-hidden">Edit <%= request.title %> request</span>
          <% end %>
        <% end %>
        <% if helpers.can? :destroy, request %>
          <%= render System::DeleteWithConfirmationComponent.new(id: "delete-#{request.id}", button_label: "Delete #{request.title} request", form_url: ill_request_path(request.id)) do |c| %>
            <% c.with_body do %>
              <div class="text-lagunita-dark"><%= type_label %></div>

              <div class="d-flex flex-column gap-1">
                <div class="text-wrap fw-semibold"><%= request.title %></div>
                <% if request.call_number.present? %>
                  <div>Call number: <%= request.call_number %></div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
